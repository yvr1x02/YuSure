# Solo sul server: mai con il prefisso NEXT_PUBLIC_, mai nei log o negli URL.

# Neon, un branch per ambiente (ADR-0001): stringa con pooling (host con "-pooler") per l'app...
DATABASE_URL=
# ...e connessione diretta per le migrazioni (npm run db:migrate).
DATABASE_URL_UNPOOLED=

# "true" turns scans on (on Vercel: Preview and Production). Unset or anything else: scans off.
SCAN_ENABLED=

# Secret for the HMAC of the IP (ADR-0003). Required: without it scans are refused.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IP_HASH_SECRET=

# Sent by Vercel to the daily cron (/api/cron/pulizia). Without it the cron is refused.
CRON_SECRET=

# Optional limits (ADR-0003): new scans per IP per hour (default 5) and in the last 24 hours (default 100).
SCAN_LIMIT_PER_IP_HOUR=
SCAN_LIMIT_DAILY=
